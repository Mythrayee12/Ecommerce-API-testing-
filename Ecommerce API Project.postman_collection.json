          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is JSON\", function () {\n    pm.response.to.be.json;\n});\n\nconst data = pm.response.json();\n\npm.test(\"Product ID is created\", function () {\n    pm.expect(data.id).to.exist;\n});\n\npm.test(\"Product title is correct\", function () {\n    pm.expect(data.title).to.eql(\"Test Laptop\");\n});\n\npm.test(\"Product price is correct\", function () {\n    pm.expect(data.price).to.eql(999);\n});\n"
            ]
          }
        }
